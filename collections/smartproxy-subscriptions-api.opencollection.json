{
  "opencollection": "1.0.0",
  "info": {
    "name": "Smartproxy Authentication Subscriptions API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Subscriptions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Subscriptions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.decodo.com/v1/users/:userId/subscriptions",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves the user's active subscription details including plan limits and validity dates."
        }
      ]
    }
  ],
  "bundled": true
}